# ─────────────────────────────────────────────────────────────
# Copy these into your Vercel project's Environment Variables.
# NEVER commit real values — this file only documents the keys.
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# If you add "Vercel Postgres" from the Vercel dashboard this is set for you.
# Otherwise paste any Postgres URL (Neon, Supabase, etc.).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Secret used to sign login session cookies. Use a long random string.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# First admin account. Created automatically on first run if no admin exists.
# The email is the admin's username.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# IMAP mailbox that receives the Netflix emails (the same inbox your imap.php used).
IMAP_HOST=imap.yourhost.com
IMAP_PORT=993
IMAP_USER=inbox@yourhost.com
IMAP_PASSWORD=your-imap-password
# Set to "false" only if your server uses STARTTLS on port 143 instead of TLS on 993.
IMAP_SECURE=true
